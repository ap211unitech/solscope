{
  "name": "SolScope MCP Server",
  "version": "1.0.0",
  "description": "SolScope Model Context Protocol server",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "start": "node dist/index.js",
    "server:inspect": "pnpm build && pnpx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@solana/kit": "^8.5.0",
    "dotenv": "^18.0.9",
    "node-cache": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
