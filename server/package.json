{
  "name": "SolScope MCP Server",
  "version": "1.0.0",
  "description": "SolScope Model Context Protocol server",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "start": "node dist/index.js",
    "lint": "eslint .. --config eslint.config.js --ext .ts",
    "lint:fix": "eslint .. --config eslint.config.js --ext .ts --fix",
    "format": "prettier --write \"../**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path ../.prettierignore",
    "format:check": "prettier --check \"../**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path ../.prettierignore",
    "server:inspect": "pnpm build && pnpx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@solana/kit": "^8.5.0",
    "dotenv": "^18.0.9",
    "node-cache": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
